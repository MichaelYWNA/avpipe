@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)

# The exported target carries the libav link interface, and those come from pkg-config imported
# targets, which do not survive an install — re-create them here.
pkg_check_modules(LIBAV REQUIRED IMPORTED_TARGET
  libavformat
  libavcodec
  libavutil
  libswscale
  libswresample
  libavfilter
)

include("${CMAKE_CURRENT_LIST_DIR}/erdeTargets.cmake")

check_required_components(erde)
